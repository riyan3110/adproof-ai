{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    }
  ],
  "functions": {
    "api/audit.mjs": {
      "maxDuration": 100
    },
    "api/improve.mjs": {
      "maxDuration": 150
    }
  }
}
