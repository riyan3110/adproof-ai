# Copy this file to .env and set MODEL_API_KEY in your hosting secret manager.
# The server does NOT load .env automatically; use node --env-file=.env server.mjs locally.
MODEL_API_KEY=your_meta_model_api_key_here
PORT=3000
# Optional override if Meta changes its supported model ID
META_MODEL=muse-spark-1.3
# Optional demo gate for public deployments that spend paid Meta API quota.
# When set, POST /api/audit and /api/improve require this code via the
# x-demo-code request header (checked before any Meta call). Leave unset for
# local development. No default value is shipped: set a strong random code in
# your Node.js hosting secret manager, never in Git or the browser.
# DEMO_ACCESS_CODE=
